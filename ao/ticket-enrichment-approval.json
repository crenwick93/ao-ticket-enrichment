        "response_schema": {
          "type": "object",
          "required": [
            "fix_available",
            "fix_template_name",
            "fix_reason"
          ],
          "properties": {
            "fix_reason": {
              "type": "string",
              "description": "A descriptive sentence explaining why this template was selected or why no fix was found"
            },
            "fix_available": {
              "type": "string",
              "description": "Whether a fix was found: 'yes' or 'no'"
            },
            "fix_template_name": {
              "type": "string",
              "description": "Exact name of the AAP job template that can fix the issue"
            }
          }
        }
      },
      "position": {
        "x": 1600,
        "y": 300
      }
    },
    {
      "id": "route_switch",
      "type": "switch",
      "name": "Remediation Available?",
      "parameters": {
        "cases": [
          {
            "port": "case_fix",
            "label": "Remediation Found",
            "condition": "${select_fix_agent.result.content.fix_available} == 'yes'"
          }
        ]
      },
      "position": {
        "x": 2000,
        "y": 300
      }
    },
    {
      "id": "create_cr",
      "type": "aap_job_template",
      "name": "Create Change Request",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "create",
          "test_plan": "Automated post-checks: nginx -t config validation, systemctl is-active nginx.",
          "inc_sys_id": "${trigger.incident_sys_id}",
          "description": "An automated remediation has been identified for incident ${trigger.incident_number}.\n\nProposed Fix: ${select_fix_agent.result.content.fix_template_name}\nReason: ${select_fix_agent.result.content.fix_reason}\n\nThis change request was raised automatically by Automation Orchestrator following AI root cause analysis. When approved and moved to Implement, the remediation will execute automatically.",
          "backout_plan": "Investigate failure in AAP job output. The rollback playbook deploys a known-good configuration.",
          "justification": "AI root cause analysis identified the issue and found an automated remediation in the AAP catalog. Approval is required before executing.",
          "fix_template_name": "${select_fix_agent.result.content.fix_template_name}",
          "short_description": "Automated Remediation — ${trigger.incident_number}",
          "implementation_plan": "Automated by Ansible Automation Platform. When this CR is moved to Implement, EDA will detect the state change and execute: ${select_fix_agent.result.content.fix_template_name}"
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
        "job_template_id": 55,
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default"
      },
      "position": {
        "x": 2400,
        "y": 200
      }
    },
    {
      "id": "approval_gate",
      "type": "approval",
      "name": "Awaiting CR Approval",
      "parameters": {
        "prompt": "Waiting for ServiceNow Change Request ${create_cr.artifacts.cr_number} approval. EDA will auto-approve this node when the CR is moved to Implement in ServiceNow."
      },
      "position": {
        "x": 2800,
        "y": 200
      }
    },
    {
      "id": "run_fix",
      "type": "aap_job_template",
      "name": "Run Remediation",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "incident_sys_id": "${trigger.incident_sys_id}",
          "incident_description": "${trigger.incident_description}"
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
        "job_template_name": "Rollback nginx Configuration",
        "organization_name": "Default"
      },
      "position": {
        "x": 3200,
        "y": 200
      }
    },
    {
      "id": "resolve_incident",
      "type": "aap_job_template",
      "name": "Resolve Incident",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "resolve",
          "inc_sys_id": "${trigger.incident_sys_id}",
          "work_notes": "[AUTOMATED — Remediation Complete] Automated remediation applied using: ${select_fix_agent.result.content.fix_template_name}. CR: ${create_cr.artifacts.cr_number}"
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
        "job_template_name": "Manage SNOW Incident",
        "organization_name": "Default"
      },
      "position": {
        "x": 3600,
        "y": 200
      }
    },
    {
      "id": "update_snow_no_fix",
      "type": "aap_job_template",
      "name": "Update SNOW (No Remediation)",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "update",
          "inc_sys_id": "${trigger.incident_sys_id}",
          "work_notes": "[AUTOMATED — No Automated Remediation Available] The AI agent searched the automation catalog but could not find a suitable remediation. Reason: ${select_fix_agent.result.content.fix_reason}. Manual intervention required."
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
