{
  "schema_version": "2.0.0",
  "name": "Ticket Enrichment + Remediation + Approval",
  "description": "Full incident lifecycle: gathers diagnostics, AI root cause analysis, updates SNOW, AI searches automation catalog, raises a Change Request for approval, waits for SNOW CR approval (bridged by EDA), then runs the remediation and resolves the incident.",
  "triggers": [
    {
      "id": "trigger_eda",
      "type": "eda_trigger",
      "name": "Incident Alert (EDA)",
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {
            "incident_number": {
              "type": "string",
              "description": "ServiceNow incident number (e.g. INC0010042)"
            },
            "incident_sys_id": {
              "type": "string",
              "description": "ServiceNow incident sys_id"
            },
            "incident_description": {
              "type": "string",
              "description": "Combined short_description + description from the incident"
            }
          }
        },
        "webhook_path": "e8a5887f-6c48-47d8-aece-e420d1abb7f4",
        "authorized_service_account_ids": [
          "15b7e9ad-e490-40bf-bc48-fa0b4d4ab5b2"
        ]
      },
      "position": {
        "x": 0,
        "y": 300
      }
    }
  ],
  "nodes": [
    {
      "id": "gather_diagnostics",
      "type": "aap_job_template",
      "name": "Gather Diagnostics",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "incident_sys_id": "${trigger.incident_sys_id}",
          "incident_description": "${trigger.incident_description}"
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
        "job_template_name": "Gather Diagnostics",
        "organization_name": "Default"
      },
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "rca_agent",
      "type": "agentic",
      "name": "AI: Root Cause Analysis",
      "parameters": {
        "prompt": "You are an expert Linux systems engineer writing a ServiceNow work note. Format your ENTIRE response as HTML using <h3> for headings, <p> for paragraphs, <ul>/<li> for lists, <code> for commands, and <pre style=\"white-space: pre-wrap; word-wrap: break-word;\"> for log excerpts. Do NOT explain your formatting choices. Do NOT use markdown. Just write the analysis directly in HTML.\n\nA ServiceNow incident has been raised and system diagnostics have been collected from the affected host. Analyse the diagnostics and provide root cause analysis, evidence from logs, remediation steps with specific commands, and prevention recommendations.\n\nIncident: ${trigger.incident_number}\nDescription: ${trigger.incident_description}\n\nDiagnostics:\n${gather_diagnostics.artifacts.diagnostics_report}",
        "llm_model_id": "943dec72-77a7-41a1-b7d2-5b576387e995",
        "tool_selection_strategy": "NONE",
        "credential_id": "c0bae15c-a4f4-4b1c-a467-7efee23080ad",
        "response_schema": {
          "type": "object",
          "required": [
            "analysis"
          ],
          "properties": {
            "analysis": {
              "type": "string",
              "description": "Full HTML-formatted root cause analysis for the ServiceNow work note"
            }
          }
        }
      },
      "position": {
        "x": 800,
        "y": 300
      }
    },
    {
      "id": "update_snow_rca",
      "type": "aap_job_template",
      "name": "Update SNOW (RCA)",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "update",
          "inc_sys_id": "${trigger.incident_sys_id}",
          "work_notes": "[AUTOMATED — AI Root Cause Analysis]${rca_agent.result.content.analysis}",
          "incident_state": "2"
        },
        "credential_id": "48ace1f1-f634-48ad-bcd3-e31e7446aef6",
        "integration_id": "424e0b19-4e8b-454a-af9d-f6a2fd40a9a9",
        "job_template_name": "Manage SNOW Incident",
        "organization_name": "Default"
      },
      "position": {
        "x": 1200,
        "y": 300
      }
    },
    {
      "id": "select_fix_agent",
      "type": "agentic",
      "name": "AI: Search Automation Catalog",
      "parameters": {
        "prompt": "You are an IT operations automation agent. A ServiceNow incident has been analysed and root cause identified. Your job is to find the correct AAP job template that can fix this issue.\n\nIncident: ${trigger.incident_number}\nDescription: ${trigger.incident_description}\nDiagnostics: ${gather_diagnostics.artifacts.diagnostics_report}\n\nSteps:\n1. Use the AAP MCP tools to list available job templates\n2. Read the descriptions carefully to find the one that can fix this specific issue\n3. If you find a matching job template, set fix_template_name to the exact name of that job template, set fix_available to 'yes', and explain why you selected it in fix_reason\n4. If no suitable job template exists, set fix_available to 'no' and explain what kind of remediation would be needed in fix_reason\n\nfix_reason must always be a descriptive sentence. Never just 'yes' or 'no'.\nDo NOT run the job template. Just identify the correct one.",
        "llm_model_id": "943dec72-77a7-41a1-b7d2-5b576387e995",
        "tool_selection_strategy": "SELECTED",
