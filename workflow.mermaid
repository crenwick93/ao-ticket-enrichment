flowchart LR
  NGINX["nginx fails"] --> PROM["Prometheus detects"]
  PROM --> ALERT["AlertManager fires"]
  ALERT --> BRIDGE["Webhook Bridge"]
  BRIDGE --> SNOW["ServiceNow Incident"]
  SNOW -->|"EDA polls"| EDA["EDA Rulebook"]
  EDA -->|"run_job_template"| BRG["Bridge: Trigger AO Workflow"]
  BRG -->|"1. OAuth2 token"| TOK["AO /api/v1/auth/token"]
  BRG -->|"2. POST payload"| AO["AO EDA Trigger Endpoint"]

  AO --> DIAG["Gather Diagnostics (AAP Job)"]
  DIAG --> RCA["AI: Root Cause Analysis"]
  RCA --> UPDATE["Update SNOW Ticket (AAP Job)"]
